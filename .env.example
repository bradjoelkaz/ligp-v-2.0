# =============================================================================
# IIGP v2.0 — Environment Variables Template
# Usage: cp .env.example .env  →  fill in real values
# Register the same keys in GitHub Actions Secrets as needed.
# =============================================================================

# -- App basics ---------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text

# -- Database -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/iigp.db
# Production: postgresql://iigp:password@db:5432/iigp
POSTGRES_PASSWORD=changeme_please

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- Naver API ----------------------------------------------------------------
# Register: https://developers.naver.com/apps/#/register (Search API)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
# Naver Blog publishing (OAuth2, blog write scope)
NAVER_BLOG_ACCESS_TOKEN=
NAVER_BLOG_REFRESH_TOKEN=
NAVER_BLOG_TOKEN=

# -- Reddit API ---------------------------------------------------------------
# App (type: script): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_app_client_secret
REDDIT_USER_AGENT=iigp-bot/2.0 (by /u/your_username)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# -- YouTube Data API ---------------------------------------------------------
# API key: https://console.cloud.google.com → enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# OAuth2 (for uploads)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# -- OpenAI -------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_MONTHLY_BUDGET_USD=10.0   # exceed -> template fallback

# -- Prefect ------------------------------------------------------------------
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_KEY=

# -- Slack --------------------------------------------------------------------
# Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_CHANNEL=#iigp-alerts

# -- Security -----------------------------------------------------------------
# API key for protected /api/* routes (X-API-Key header). Leave EMPTY to
# disable authentication (development mode). Public routes (/health, /ready,
# /version, /metrics, /admin, /docs) always bypass auth.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=generate_a_strong_random_hex_key_here

# -- Grafana (Phase 8) --------------------------------------------------------
GRAFANA_PASSWORD=changeme_grafana

# -- Pushgateway (Phase 9) ----------------------------------------------------
# Where the worker/batch process pushes its metrics. Defaults to localhost:9091
# when unset. In docker-compose this is set to the pushgateway service.
PUSHGATEWAY_URL=pushgateway:9091
