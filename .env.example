# =============================================================================
# IIGP v2.0 — Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Secret management (QA-027): prefer HashiCorp Vault in production; .env is the
# local/dev fallback. OAuth tokens are auto-refreshed by utils/auth_manager.py.
# =============================================================================

# ---- Runtime / App ----------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | text
TZ=Asia/Seoul

# ---- Secret backend (QA-027) ------------------------------------------------
SECRET_BACKEND=dotenv               # dotenv | vault
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=
VAULT_NAMESPACE=iigp

# ---- Data Ingestion APIs (Layer 1) ------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=iigp/2.0
YOUTUBE_API_KEY=
GOOGLE_NEWS_API_KEY=
SOCIALBLADE_API_KEY=                # CPM history source (QA-015)

# ---- Content Generation (Layer 9) -------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERSPECTIVE_API_KEY=                # Toxicity filter, Quality Gate 4 (DD-010)
SUNO_API_KEY=

# ---- Publishing (Layer 10) --------------------------------------------------
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
NEWSLETTER_API_KEY=

# ---- Datastores -------------------------------------------------------------
SQLITE_PATH=./data/iigp.db
POSTGRES_DSN=postgresql://iigp:iigp@localhost:5432/iigp
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=redis://localhost:6379/0  # TokenBucket distributed counter (QA-002)
VECTOR_DB_URL=http://localhost:6333 # Qdrant (768dim embeddings)

# ---- Backup / DR (QA-029) ---------------------------------------------------
BACKUP_BUCKET=s3://iigp-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# ---- Observability (Layer 0 / QA-028) ---------------------------------------
PROMETHEUS_PUSHGATEWAY=http://localhost:9091
GRAFANA_URL=http://localhost:3000
ALERTMANAGER_URL=http://localhost:9093
SLACK_WEBHOOK_URL=

# ---- Cost / Budget control (GAP-006 / QA-022) -------------------------------
LLM_DAILY_BUDGET_USD=50
LLM_MONTHLY_BUDGET_USD=1000
