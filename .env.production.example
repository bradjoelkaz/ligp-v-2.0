# =============================================================================
# IIGP v2.0 — Production environment template
#   cp .env.production.example .env.production   # then fill in real secrets
# NEVER commit the filled-in .env.production (it is git-ignored).
# =============================================================================

# -- App / network ------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
API_PORT=8000
UVICORN_WORKERS=2          # NOTE: see deployment.md re: multiprocess /metrics

# -- Database (PostgreSQL in production) --------------------------------------
# psycopg form. Append ?connect_timeout=2 to bound the /health DB probe.
DATABASE_URL=postgresql://iigp:CHANGE_ME@db:5432/iigp?connect_timeout=2
POSTGRES_DB=iigp
POSTGRES_USER=iigp
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Security -----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=CHANGE_ME_api_key          # X-API-Key for /api/* (empty disables)
ADMIN_API_KEY=CHANGE_ME_admin_key         # X-API-Key for POST /admin/api/node|edge

# -- Observability ------------------------------------------------------------
PUSHGATEWAY_URL=pushgateway:9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
# For multi-worker metric aggregation (prometheus_client multiprocess mode).
# Leave unset to run a single API worker with an in-process registry.
# PROMETHEUS_MULTIPROC_DIR=/tmp/iigp_prom_multiproc

# -- Content generation (optional) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MONTHLY_BUDGET_USD=10.0

# -- Phase 9: live channel APIs ----------------------------------------------
# In production (APP_ENV=production) the offline mock fallbacks are DISABLED:
# missing keys cause real errors to be logged instead of fake success responses.
# Set IIGP_ALLOW_MOCK=1 to re-enable mocks for a prod-like smoke test.
IIGP_ALLOW_MOCK=

# Data collection
YOUTUBE_API_KEY=CHANGE_ME_youtube_data_api_v3_key
YOUTUBE_CHANNEL_IDS=                       # optional CSV of channel IDs (RSS mode)
NAVER_CLIENT_ID=CHANGE_ME_naver_client_id
NAVER_CLIENT_SECRET=CHANGE_ME_naver_client_secret

# AI processing (one of the two; OPENROUTER preferred)
OPENROUTER_API_KEY=CHANGE_ME_openrouter_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Social publishing tokens
TISTORY_ACCESS_TOKEN=
WORDPRESS_API_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
NAVER_BLOG_TOKEN=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Scheduling + alerting
PIPELINE_INTERVAL_HOURS=6
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#iigp-alerts

# -- Image tag for docker-compose.prod.yml ------------------------------------
IMAGE_TAG=latest
