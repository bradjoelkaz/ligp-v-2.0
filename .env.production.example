# =============================================================================
# IIGP v2.0 — Production environment template
#   cp .env.production.example .env.production   # then fill in real secrets
# NEVER commit the filled-in .env.production (it is git-ignored).
# =============================================================================

# -- App / network ------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
API_PORT=8000
UVICORN_WORKERS=2          # NOTE: see deployment.md re: multiprocess /metrics

# -- Database (PostgreSQL in production) --------------------------------------
# psycopg form. Append ?connect_timeout=2 to bound the /health DB probe.
DATABASE_URL=postgresql://iigp:CHANGE_ME@db:5432/iigp?connect_timeout=2
POSTGRES_DB=iigp
POSTGRES_USER=iigp
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Security -----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=CHANGE_ME_api_key          # X-API-Key for /api/* (empty disables)
ADMIN_API_KEY=CHANGE_ME_admin_key         # X-API-Key for POST /admin/api/node|edge

# -- Observability ------------------------------------------------------------
PUSHGATEWAY_URL=pushgateway:9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
# For multi-worker metric aggregation (prometheus_client multiprocess mode).
# Leave unset to run a single API worker with an in-process registry.
# PROMETHEUS_MULTIPROC_DIR=/tmp/iigp_prom_multiproc

# -- Content generation (optional) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MONTHLY_BUDGET_USD=10.0

# -- Image tag for docker-compose.prod.yml ------------------------------------
IMAGE_TAG=latest
