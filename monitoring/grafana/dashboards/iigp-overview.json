{
  "title": "IIGP v2.0 Overview",
  "uid": "iigp-overview",
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["iigp", "overview"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(iigp_http_requests_total[5m])) by (path)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Latency p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(iigp_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Requests",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(iigp_http_requests_total)", "legendFormat": "requests", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Requests In Progress",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "expr": "sum(iigp_http_requests_in_progress)", "legendFormat": "in progress", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Responses by Status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(iigp_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "5xx Error Rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(iigp_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Graph Nodes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [
        { "expr": "iigp_graph_nodes", "legendFormat": "nodes", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Graph Edges",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "targets": [
        { "expr": "iigp_graph_edges", "legendFormat": "edges", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "Content Generated (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(iigp_content_generated_total[5m])) by (platform, quality)",
          "legendFormat": "{{platform}} / {{quality}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Pipeline Runs (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(iigp_pipeline_runs_total[5m])) by (pipeline, status)",
          "legendFormat": "{{pipeline}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Pipeline Duration p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(iigp_pipeline_duration_seconds_bucket[5m])) by (le, pipeline))",
          "legendFormat": "{{pipeline}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Collector Documents (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(iigp_collector_documents_total[5m])) by (source, status)",
          "legendFormat": "{{source}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "PostgreSQL Connection Pool",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(iigp_db_pool_connections_active)",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(iigp_db_pool_connections_total)",
          "legendFormat": "total",
          "refId": "B"
        }
      ]
    },
    {
      "id": 14,
      "title": "Celery Queue Length",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "max(iigp_celery_queue_length)",
          "legendFormat": "pending tasks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Celery Queue Backlog (now)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 40 },
      "targets": [
        { "expr": "max(iigp_celery_queue_length)", "legendFormat": "pending", "refId": "A" }
      ]
    }
  ]
}
